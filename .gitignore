# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Environment files and secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow tracking all .env.example files
!.env.example
!apps/*/.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage artifacts
coverage/
.nyc_output/

# Caches
.cache/
.vite/
.parcel-cache/
.eslintcache/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE and Editor files
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Database dumps and local bind mount data
*.dump
*.sql.gz
postgres-data/
pgdata/

# Local private file storage
apps/api/storage/*
!apps/api/storage/.gitkeep

# SSL / TLS certs and private keys
*.pem
*.key
*.cert
*.crt
