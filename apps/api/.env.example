# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/class_fund?schema=public"

# Test Database URL (for running tests without modifying dev/prod)
TEST_DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/class_fund_test?schema=public"

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_local_only_min_32_characters_long_123456
JWT_EXPIRES_IN=7d

# CORS Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8443
